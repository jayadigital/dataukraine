# Optional local model commands. Each command reads the prompt from stdin.
PHI_CMD="ollama run phi4"
MAMAY_CMD="ollama run mamay"

# Optional flat-file origin/mirror. Configure bucket CORS for the UI domain.
GCS_BUCKET=""
GOOGLE_APPLICATION_CREDENTIALS=""
GCS_ARCHIVE_RELEASES="0"

# Build the UI against GCS instead of Cloudflare-hosted /data files.
VITE_DATA_BASE_URL=""
