{
  "name": "dataukraine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:all && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "build:app": "tsc -b && vite build",
    "audit:release": "node scripts/audit-release.mjs",
    "preview": "vite preview",
    "admin": "node scripts/admin-server.mjs",
    "admin:budget": "RI_CORNER=budget RI_ADMIN_PORT=4176 node scripts/admin-server.mjs",
    "admin:oecd": "RI_CORNER=oecd RI_ADMIN_PORT=4177 node scripts/admin-server.mjs",
    "admin:wb": "RI_CORNER=wb RI_ADMIN_PORT=4178 node scripts/admin-server.mjs",
    "admin:ilostat": "RI_CORNER=ilostat RI_ADMIN_PORT=4179 node scripts/admin-server.mjs",
    "admin:imf": "RI_CORNER=imf RI_ADMIN_PORT=4180 node scripts/admin-server.mjs",
    "admin:eurostat": "RI_CORNER=eurostat RI_ADMIN_PORT=4181 node scripts/admin-server.mjs",
    "admin:comtrade": "RI_CORNER=comtrade RI_ADMIN_PORT=4182 node scripts/admin-server.mjs",
    "admin:tradingeconomics": "RI_CORNER=tradingeconomics RI_ADMIN_PORT=4183 node scripts/admin-server.mjs",
    "admin:ukraine": "RI_CORNER=ukraine RI_ADMIN_PORT=4184 node scripts/admin-server.mjs",
    "admin:industrial": "RI_CORNER=industrial RI_ADMIN_PORT=4185 node scripts/admin-server.mjs",
    "admin:worldsteel": "RI_CORNER=worldsteel RI_ADMIN_PORT=4186 node scripts/admin-server.mjs",
    "admin:owid": "RI_CORNER=owid RI_ADMIN_PORT=4187 node scripts/admin-server.mjs",
    "data:budget": "node --max-old-space-size=2048 scripts/corners/build-budget.mjs",
    "data:oecd": "node scripts/corners/build-oecd.mjs",
    "data:wb": "node scripts/corners/build-wb.mjs",
    "data:ilostat": "node --max-old-space-size=2048 scripts/corners/build-ilostat.mjs",
    "data:imf": "node scripts/corners/build-imf.mjs",
    "data:eurostat": "node --max-old-space-size=3072 scripts/corners/build-eurostat.mjs",
    "data:comtrade": "node scripts/corners/build-comtrade.mjs",
    "data:tradingeconomics": "node scripts/corners/build-tradingeconomics.mjs",
    "data:industrial": "node scripts/corners/build-industrial.mjs",
    "data:worldsteel": "node scripts/corners/build-worldsteel.mjs",
    "data:owid": "node scripts/corners/build-owid.mjs",
    "data:uconomics": "node scripts/corners/build-uconomics.mjs",
    "data:foresight": "node scripts/corners/build-foresight.mjs",
    "data:special": "node scripts/corners/prepare-special-corners.mjs",
    "data:ukraine": "node scripts/corners/build-ukraine.mjs",
    "data:translations": "node scripts/build-title-translations.mjs",
    "data:new": "npm run data:ilostat && npm run data:imf && npm run data:eurostat && npm run data:comtrade && npm run data:tradingeconomics",
    "data:all": "npm run data:special && npm run data:budget && npm run data:oecd && npm run data:wb && npm run data:new && npm run data:industrial && npm run data:worldsteel && npm run data:owid && npm run data:ukraine && npm run data:uconomics && npm run data:foresight",
    "report:review": "node scripts/weekly-local.mjs",
    "refresh:monthly": "node scripts/refresh-protofund.mjs",
    "refresh:weekly": "node scripts/refresh-protofund.mjs --weekly",
    "publish:monthly": "node scripts/refresh-protofund.mjs --publish",
    "publish:weekly": "node scripts/refresh-protofund.mjs --weekly --publish",
    "test": "node --test scripts/*.test.mjs scripts/corners/*.test.mjs",
    "cf:dev": "npm run build:app && wrangler dev --config wrangler.budget.jsonc",
    "cf:deploy": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/pt-serif": "^5.2.7",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
